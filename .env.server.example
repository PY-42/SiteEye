# SiteEye Proxy Server — environment variables
# Copy to .env on the proxy host and fill in your values

# OpenAI API key (Whisper STT + TTS + GPT-4o vision)
OPENAI_API_KEY=sk-...

# OpenClaw gateway (local, internal to server)
OPENCLAW_URL=http://127.0.0.1:18790/v1/chat/completions
OPENCLAW_TOKEN=your-openclaw-token-here
