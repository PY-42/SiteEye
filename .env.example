# SiteEye Pi Client — environment variables
# Copy to .env and fill in your values
# Load with: set -a && source .env && set +a

# Proxy server URL (no trailing slash)
SITEEYE_PROXY=https://your-proxy.example.com

# Telegram bot for mirroring device activity to your phone (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
